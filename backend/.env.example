# Arrow (iRage) API credentials -- get these from https://arrow.trade after app registration
ARROW_APP_ID=your_app_id
ARROW_APP_SECRET=your_app_secret
ARROW_USER_ID=your_client_id
ARROW_PASSWORD=your_password
ARROW_TOTP_SECRET=your_totp_secret

# Safety switch. Keep this "true" until you have tested every tab end-to-end.
# When true, no order ever reaches Arrow -- fills are simulated against live LTP.
PAPER_MODE=true

# Starting virtual cash for the paper engine
PAPER_STARTING_CASH=1000000

# Where the terminal serves the UI from
HOST=127.0.0.1
PORT=8000

# Token cache file so you don't have to re-auth every restart within the 24h SEBI window
TOKEN_CACHE_PATH=.arrow_token.json
